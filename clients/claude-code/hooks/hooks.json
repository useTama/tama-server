{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-end.mjs",
              "${user_config.server_url}",
              "${user_config.device_token}",
              "${user_config.auto_save}"
            ],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
