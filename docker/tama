#!/bin/sh
# `tama <command>` for a Docker deployment.
#
# The installed binary is `tama-server`; a container deployment has no binary on
# the host, and asking someone to remember
#
#   docker compose --profile whatsapp-webjs logs -f whatsapp-webjs
#
# to read a log is deployment plumbing leaking into the interface. This wrapper
# is the host-side equivalent of the CLI, run from wherever the repo is:
#
#   sudo ln -s "$PWD/docker/tama" /usr/local/bin/tama
#
# It resolves its own location, so the symlink works from any directory.
set -e

# Compose warns on every invocation that it wants to build with Bake but buildx
# is missing. It is advice about a build backend, printed before a command that
# may not build anything.
export COMPOSE_BAKE=${COMPOSE_BAKE:-false}

self=$0
# Follow the symlink so TAMA_DIR is the repo, not /usr/local/bin.
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *)  self=$(dirname "$self")/$link ;;
  esac
done
TAMA_DIR=${TAMA_DIR:-$(cd "$(dirname "$self")/.." && pwd)}
cd "$TAMA_DIR"

# Every command that touches the bridge needs its profile, or Compose treats the
# container as an orphan and stops it. Getting that wrong is the single most
# common way to break a working install, so the wrapper always passes it.
compose() { docker compose --profile whatsapp-webjs "$@"; }

# ---- public deployment ----------------------------------------------------
#
# The overlay is not a flag this script passes; it is two lines in `.env`.
#
# COMPOSE_FILE is read by Compose itself from the project directory, and this
# script cds to the repo root before anything else, so writing it there makes
# `compose()`, `wizard()` AND a `docker compose` typed by hand out of the docs
# all load the Caddy file. None of those three call sites change.
#
# The alternative - teaching compose() a conditional `-f` - needs the same edit
# in wizard(), re-derives the answer on every invocation, and still leaves a
# hand-typed command broken. It is more code that does less.
#
# The two keys are written together and removed together, always. Compose
# aborts every command with "required variable TAMA_DOMAIN is missing a value"
# if COMPOSE_FILE names the overlay while TAMA_DOMAIN is absent, so either line
# on its own is a box where `tama logs` and `tama status` no longer run.
COMPOSE_OVERLAY="docker-compose.yml:docker-compose.caddy.yml"

# The domain this deployment is public at, or empty.
public_domain() {
  [ -f .env ] || return 0
  sed -n 's/^TAMA_DOMAIN=//p' .env | tail -1
  return 0
}

# A hostname a public CA could actually issue for.
#
# Rejects a bare IPv4 and the reserved suffixes, because both produce a Caddy
# site address that will never get a certificate - and the failure arrives
# minutes later as an ACME error rather than here as a typo.
valid_domain() {
  case $1 in
    # The last two catch a hyphen at the edge of an inner label - "trail-.com",
    # ".-lead" - which the leading/trailing patterns alone let through.
    *[!a-zA-Z0-9.-]*|-*|*-|.*|*.|*..*|*-.*|*.-*|"") return 1 ;;
    *.local|*.internal|*.lan|*.localdomain|localhost) return 1 ;;
  esac
  # A bare IPv4: every label numeric.
  case $1 in
    *[!0-9.]*) ;;
    *) return 1 ;;
  esac
  # At least one dot, so a single label cannot be a public name.
  case $1 in *.*) return 0 ;; *) return 1 ;; esac
}

# An HTTP status, or 000 when the connection did not happen.
#
# `curl ... || echo 000` is the obvious spelling and it is wrong: on a refused
# connection curl writes its own 000 through -w AND exits non-zero, so the
# fallback appends and the caller sees 000000. Capture, then default.
http_code() {
  code=$(curl -s -o /dev/null -m "${2:-5}" -w '%{http_code}' "$1" 2>/dev/null || true)
  printf '%s' "${code:-000}"
  return 0
}

# Does TLS terminate correctly for this domain, asked from this machine?
#
# --resolve, not a plain request to the domain. This command runs ON the server,
# and a cloud instance cannot reach its own public address through the gateway
# in front of it - a plain curl returns 000 on a deployment that is working
# perfectly, which would make the command report failure at the moment of
# success. Pinning the name to loopback tests the certificate, the SNI match and
# the proxy to tama, which is everything this script is responsible for. Whether
# the internet can reach port 443 is the security group's business and is
# checked separately, best-effort.
cert_code() {
  code=$(curl -s -o /dev/null -m "${2:-8}" --resolve "$1:443:127.0.0.1" \
    -w '%{http_code}' "https://$1/health" 2>/dev/null || true)
  printf '%s' "${code:-000}"
  return 0
}

# Read one value from the SERVER block only.
#
# config_value falls through to the whatsapp block, which is right when asking
# "where is this server" and wrong when asking "did --off clear the key": on a
# Cloud API deployment the fallback would answer with Meta's callback origin and
# --off would look like it had not worked.
config_value_server() {
  sudo python3 -c "
import json,sys
try:
    c=json.load(open('config/tama.config.json'))
except Exception:
    sys.exit(0)
print((c.get('server') or {}).get('$1') or '')
" 2>/dev/null || true
}

# Remove a key from the server block. set_config_value can only write one, and
# writing "" is not the same as absent: config_value would fall through to the
# whatsapp block and report an address --off has just taken down.
unset_config_value() {
  sudo python3 -c "
import json
p='config/tama.config.json'
c=json.load(open(p))
(c.get('server') or {}).pop('$1', None)
open(p,'w').write(json.dumps(c,indent=2)+'\n')
" 2>/dev/null || echo "config: could not clear $1"
  return 0
}

# Where the vault is on this host, or empty when it is still a Docker volume.
# Read from .env rather than the config, because the config's path is a
# container path and this runs outside.
vault_dir() {
  [ -f .env ] || return 0
  dir=$(sed -n 's/^TAMA_VAULT_DIR=//p' .env | tail -1)
  [ -n "$dir" ] && [ -d "$dir" ] && printf '%s' "$dir"
}

# This machine's tailnet name, as an https URL, or empty.
tailscale_url() {
  # Always exits 0. A function whose last command is a failing test takes the
  # whole script down under set -e when its output is captured in an
  # assignment, which is how `tama expose status` died on a machine that had
  # tailscale installed but not signed in.
  name=$(tailscale status --json 2>/dev/null | sed -n 's/.*"DNSName" *: *"\([^"]*\)".*/\1/p' | head -1)
  name=${name%.}
  [ -n "$name" ] && printf 'https://%s' "$name"
  return 0
}

# Read one value out of the config. sudo, because the wizard writes it 0600 and
# root-owned.
#
# server first, then whatsapp. The whatsapp fallback is not tidiness: every
# deployment where `tama expose` already ran has the value there, and an
# upgrade that stopped reading it would make a working box report itself as
# unreachable.
config_value() {
  sudo python3 -c "
import json,sys
try:
    c=json.load(open('config/tama.config.json'))
except Exception:
    sys.exit(0)
print((c.get('server') or {}).get('$1') or (c.get('whatsapp') or {}).get('$1') or '')
" 2>/dev/null || true
}

# Write one value without disturbing anything else in the file: it is the
# wizard's file and it holds secrets this command has no business rewriting.
#
# It writes into the server block, which every loadable config has, because
# server.adminToken is required. That is the whole point of the key having
# moved there.
#
# It used to write into whatsapp, and had to refuse whenever that block was
# absent - every install using the unofficial bridge rather than the Cloud API.
# loadConfig demands a digits-only phoneNumberId from any whatsapp block that
# exists at all, so inventing one turned a config that loaded into one that
# throws, and index.ts turned that into a restart loop: the command whose job
# is making the server reachable made it refuse to boot. The parser was right
# to be strict. The key was in the wrong place.
set_config_value() {
  sudo python3 -c "
import json, sys
p='config/tama.config.json'
c=json.load(open(p))
c.setdefault('server', {})['$1']='$2'
open(p,'w').write(json.dumps(c,indent=2)+'\n')
print('config: $1 set to $2')
" 2>/dev/null || echo "config: could not set $1 (is the config where it should be?)"
}

require_vault_dir() {
  dir=$(vault_dir)
  if [ -z "$dir" ]; then
    echo "The vault is still inside a Docker volume, so git on this host cannot reach it." >&2
    echo "Move it to a folder first: docs/deploy-docker.md section 13b" >&2
    return 1
  fi
  printf '%s' "$dir"
}

# The wizards still build, so that a `git pull` takes effect rather than running
# whatever the image happened to contain - a stale settings image is how you end
# up answering questions the running code does not read. Cached, that is about a
# second, and there is no reason to print thirty lines of layer cache hits for
# it.
wizard() { docker compose --progress quiet run --rm --build "$@"; }

command=${1:-help}
[ $# -gt 0 ] && shift

case $command in
  setup)    wizard setup "$@" ;;
  settings) wizard settings "$@" ;;
  start|up) compose up -d --build "$@" ;;
  stop)     compose stop "$@" ;;
  restart)  compose up -d --build "$@" ;;
  status|ps)
    compose ps "$@"
    # Three separate debugging sessions ended at "you never restarted". The
    # containers carry their build time and the checkout carries its commit
    # time, so staleness is answerable rather than inferred from which log
    # lines are missing.
    head_time=$(git log -1 --format=%ct 2>/dev/null || echo 0)
    if [ "$head_time" != "0" ]; then
      stale=""
      for c in $(compose ps -q 2>/dev/null); do
        built=$(docker inspect -f '{{.Created}}' "$c" 2>/dev/null || true)
        [ -n "$built" ] || continue
        built_ts=$(date -d "$built" +%s 2>/dev/null || echo 0)
        [ "$built_ts" != "0" ] && [ "$built_ts" -lt "$head_time" ] && stale="yes"
      done
      echo ""
      if [ -n "$stale" ]; then
        echo "Your checkout is newer than what is running: $(git log -1 --format='%h %s')"
        echo "  tama restart"
      else
        echo "Running $(git log -1 --format='%h %s')"
      fi
    fi
    ;;
  logs)     compose logs -f --tail 100 "${@:-tama}" ;;
  # With the admin token, because /health tells an unauthenticated caller only
  # that the server is alive. The operator asking from the box it runs on wants
  # the half that says whether whisper is up and whether ask is configured.
  health)
    admin=$(config_value adminToken)
    if [ -n "$admin" ]; then
      curl -s -H "Authorization: Bearer $admin" localhost:8080/health
    else
      curl -s localhost:8080/health
    fi
    ;;

  # Everything a client needs, in one command, as a line to paste.
  #
  # Setting up the editor plugin used to be four separate acts of assembly:
  # mint a token here, copy it, work out for yourself which address the laptop
  # can reach, and then compose an install command from a doc. Every one of
  # those is a step where somebody stops. And the token step is the worst of
  # them, because the only way to get a value from this box into a command on
  # a laptop is to paste it somewhere - which is how a live credential ends up
  # in a chat log.
  #
  # So this prints the finished command. The address is chosen rather than
  # asked for: the tailnet name if this machine is serving on one, then a
  # configured publicBaseUrl, then loopback with a note about what that means.
  mcp|connect)
    name=${1:-claude-code}

    url=$(tailscale_url)
    # `tailscale serve status` prints "No serve config" when it is not serving,
    # which is output - so testing for "any output" says yes when the answer is
    # no, and this command then hands over a name that resolves and a port that
    # never answers. That is a worse failure than loopback, because it looks
    # like a working address. Match what it actually says.
    if [ -n "$url" ] && tailscale serve status 2>/dev/null | grep -qi "no serve config"; then
      # On a tailnet but not serving: the name resolves and the port does not
      # answer, which is a worse failure than loopback because it looks like a
      # working address.
      echo "This machine is on a tailnet but not serving yet. Run 'tama expose' first," >&2
      echo "or press on and use the loopback address with a tunnel." >&2
      echo "" >&2
      url=""
    fi
    [ -z "$url" ] && url=$(config_value publicBaseUrl)
    reach=""
    if [ -z "$url" ]; then
      url="http://127.0.0.1:8080"
      reach="loopback"
    fi

    token=$(compose exec -T tama bun run src/tama.ts token "$name" 2>/dev/null | grep -oE '[0-9a-f]{64}' | head -1)
    if [ -z "$token" ]; then
      echo "Could not mint a token. Is tama running? 'tama status'" >&2
      exit 1
    fi

    echo "Run these two lines on the machine you work on:"
    echo ""
    echo "  claude plugin marketplace add useTama/tama-server"
    echo "  claude plugin install tama@usetama --scope user \\"
    echo "    --config server_url=$url \\"
    echo "    --config device_token=$token"
    echo ""
    if [ "$reach" = "loopback" ]; then
      echo "That address is this machine's loopback, so it only works if you work HERE."
      echo "From a laptop, either:"
      echo "  tama expose                      a tailnet address, no tunnel, every device"
      echo "  scripts/tama-tunnel install ...   an ssh tunnel that restarts itself"
      echo ""
    fi
    echo "The token is unrestricted and shown once. It went to this terminal and"
    echo "nowhere else - keep it out of a chat window, and revoke it under Devices"
    echo "in 'tama settings' if it ever gets somewhere it should not be."
    ;;

  # Make this daemon addressable, once, and print the URL.
  #
  # Four features wanted this and each had its own workaround: MCP needed an
  # SSH tunnel in a terminal you must not close, off-LAN phone pairing was
  # impossible, the WhatsApp Cloud API needs a callback, and publicBaseUrl sat
  # unset. The fix is one thing, not four.
  #
  # Tailscale is the default rather than a public domain because a server
  # holding one person's notes should not need port 443 on the internet to
  # make an editor plugin work. --public is there for someone who genuinely
  # wants strangers to reach it.
  expose)
    mode=${1:-tailscale}
    # Shift, so a DOMAIN argument is $1 inside the branch. Without this
    # `--public tama.example.com` reads its own flag name as the domain.
    [ $# -gt 0 ] && shift
    case $mode in
      status)
        if command -v tailscale >/dev/null 2>&1; then
          url=$(tailscale_url)
          [ -n "$url" ] && echo "tailnet: $url" || echo "tailnet: tailscale installed but this machine is not serving"
          tailscale serve status 2>/dev/null || true
        else
          echo "tailnet: tailscale not installed"
        fi

        domain=$(public_domain)
        if [ -n "$domain" ]; then
          # The overlay named but not present is what a bad checkout or an old
          # tag looks like, and it is otherwise undiagnosable: every compose
          # command fails and none of them says why.
          if [ ! -f docker-compose.caddy.yml ]; then
            echo "public:  $domain, but docker-compose.caddy.yml is MISSING from this checkout"
          else
            code=$(cert_code "$domain")
            case $code in
              200) echo "public:  https://$domain (certificate valid, serving)" ;;
              000) echo "public:  $domain configured, but nothing answered on 443 here (is caddy running? tama logs caddy)" ;;
              *)   echo "public:  $domain, TLS works and the server answered $code" ;;
            esac
            # The only check that would notice a renewal that quietly stopped -
            # a box switched off for six weeks, or port 80 closed by a later
            # security-group edit. openssl is optional, as preflight.sh treats it.
            if command -v openssl >/dev/null 2>&1; then
              until_when=$(printf '' | openssl s_client -connect 127.0.0.1:443 -servername "$domain" 2>/dev/null \
                | openssl x509 -noout -enddate 2>/dev/null | sed -n 's/^notAfter=//p')
              [ -n "$until_when" ] && echo "cert:    expires $until_when"
            fi
          fi
        else
          echo "public:  not configured"
        fi

        base=$(config_value_server publicBaseUrl)
        echo "config:  server.publicBaseUrl ${base:-unset}"
        ;;

      --off|off)
        domain=$(public_domain)
        if [ -n "$domain" ]; then
          # Order matters and is the difference between reversible and not.
          # `compose rm` must run while COMPOSE_FILE still names the overlay:
          # strip .env first and the caddy container becomes invisible to every
          # compose command on the box, while `restart: unless-stopped` keeps it
          # holding 0.0.0.0:443 with nothing able to see, stop or log it.
          if ! compose rm -sf caddy >/dev/null 2>&1; then
            echo "Could not remove the caddy container, so .env is left alone." >&2
            echo "  Removing it by hand is: docker rm -f \$(docker ps -q --filter name=caddy)" >&2
            echo "  Stripping .env first would leave it holding port 443 where no tama" >&2
            echo "  command can see or stop it, so this stops here instead." >&2
            exit 1
          fi
          # Both keys together, always: COMPOSE_FILE naming the overlay without
          # TAMA_DOMAIN aborts every compose command on the machine.
          sed -i '/^TAMA_DOMAIN=/d;/^COMPOSE_FILE=/d' .env
          unset_config_value publicBaseUrl
          unset_config_value trustProxy
          echo "No longer public. $domain is no longer served and the certificate is not renewed."
          echo "  The A record still points here - remove it if you are done with it."
          echo "  The issued certificate is kept in the caddy-data volume, so turning this"
          echo "  back on does not re-issue and does not spend a rate-limit allowance."
          echo "  Do not 'docker compose down -v' to tidy up: that deletes it, and the vault."
        fi

        command -v tailscale >/dev/null 2>&1 && sudo tailscale serve reset || true
        # if/fi rather than `[ ... ] && echo`: under set -e a failing test as the
        # last command of a branch takes the whole script down with it.
        if [ -z "$domain" ]; then
          echo "No longer served on the tailnet. The daemon still listens on 127.0.0.1:8080."
        fi
        ;;

      --public|public)
        domain=${1:-}

        if [ -z "$domain" ]; then
          echo "usage: tama expose --public DOMAIN"
          echo ""
          echo "A public host is a bigger commitment than the tailnet default:"
          echo "  a domain, an A record pointing here, and ports 80 and 443 open."
          echo ""
          echo "You want it if something that is not YOUR machine has to dial in -"
          echo "a ChatGPT or Claude connector, or the WhatsApp Cloud API. For MCP"
          echo "from your own laptop, phone pairing and your own devices, plain"
          echo "'tama expose' is enough and puts nothing on the public internet."
          exit 2
        fi

        if ! valid_domain "$domain"; then
          echo "\"$domain\" is not a hostname a public certificate authority can issue for." >&2
          echo "  It needs a real registered name with a dot in it: tama.example.com." >&2
          echo "  An IP address, localhost, and .local/.internal/.lan names cannot get one." >&2
          exit 1
        fi

        current=$(public_domain)
        if [ "$current" = "$domain" ] && [ "$(cert_code "$domain")" = "200" ]; then
          echo "Already public at https://$domain, certificate valid. Nothing to do."
          exit 0
        fi
        if [ -n "$current" ] && [ "$current" != "$domain" ]; then
          echo "This deployment is already configured for $current." >&2
          echo "  Run 'tama expose --off' first, then --public $domain." >&2
          exit 1
        fi

        if [ ! -f docker-compose.caddy.yml ]; then
          echo "docker-compose.caddy.yml is not in this checkout, so there is nothing to bring up." >&2
          exit 1
        fi

        # Best-effort, and a warning rather than a refusal: an A record added a
        # minute ago has not propagated to this resolver yet, and refusing on
        # that would send people away to wait when the certificate would have
        # issued fine by the time Caddy asked.
        if command -v getent >/dev/null 2>&1; then
          resolved=$(getent hosts "$domain" 2>/dev/null | awk '{print $1}' | head -1 || true)
          if [ -z "$resolved" ]; then
            echo "! $domain does not resolve from this machine yet."
            echo "  If you have just added the A record this is normal. If you have not"
            echo "  added one, the certificate will fail and this will tell you so."
            echo ""
          fi
        fi

        # A competing listener is the one failure Docker reports as an opaque
        # bind error, and the repo already has advice for it worth printing here
        # rather than after the fact.
        holder=$(docker ps --no-trunc --filter publish=80 --filter publish=443 --format '{{.Names}}' 2>/dev/null | grep -v caddy || true)
        if [ -n "$holder" ]; then
          echo "! Something already publishes port 80 or 443: $holder"
          echo "  Two things cannot hold the same port. If that is a proxy you run,"
          echo "  do not start this one - point yours at 127.0.0.1:8080 instead."
          echo "  docs/deploy-docker.md section 9 has the vhost."
          echo ""
        fi

        echo "This will put your notes server on the public internet at https://$domain."
        echo ""
        echo "  Caddy takes ports 80 and 443 and gets a Let's Encrypt certificate."
        echo "  Anyone who finds the hostname can reach the login, though not the"
        echo "  vault: every route still needs a device token, wrong ones are"
        echo "  throttled, and /health tells a stranger only that the server is up."
        echo ""
        printf 'Make it public? [y/N]: '
        read -r answer
        case $answer in [yY]*) ;; *) echo "Nothing changed."; exit 0 ;; esac

        previous=$(config_value_server publicBaseUrl)

        # One write, both keys, delete-then-append: a second line for the same
        # key wins silently and leaves the first looking authoritative.
        touch .env
        sed -i '/^TAMA_DOMAIN=/d;/^COMPOSE_FILE=/d' .env
        echo "TAMA_DOMAIN=$domain" >> .env
        echo "COMPOSE_FILE=$COMPOSE_OVERLAY" >> .env

        # Prove the two lines just written produce a model Compose can load,
        # before anything is started. Cheap, and it is the only guard against
        # leaving a box where `tama logs` and `tama status` no longer run.
        if ! compose config -q >/dev/null 2>&1; then
          sed -i '/^TAMA_DOMAIN=/d;/^COMPOSE_FILE=/d' .env
          echo "Compose could not load the Caddy overlay, so nothing was started." >&2
          echo "  .env has been put back. Run 'docker compose config' to see why." >&2
          exit 1
        fi

        echo ""
        echo "Starting Caddy..."
        if ! compose up -d --build; then
          # Remove the container FIRST, while COMPOSE_FILE still names its file.
          compose rm -sf caddy >/dev/null 2>&1 || true
          sed -i '/^TAMA_DOMAIN=/d;/^COMPOSE_FILE=/d' .env
          echo "" >&2
          echo "Caddy did not start, so nothing is public and .env has been put back." >&2
          echo "  The usual cause is ports 80 or 443 already in use. If that is a proxy" >&2
          echo "  you run, point it at 127.0.0.1:8080 instead of starting this one." >&2
          exit 1
        fi

        # A deadline, not an iteration count: each probe can itself consume its
        # whole timeout, so counting attempts bounds the wait anywhere between
        # two and ten minutes.
        echo "Waiting for the certificate (up to two minutes)..."
        deadline=$(( $(date +%s) + 120 ))
        code=000
        while [ "$(date +%s)" -lt "$deadline" ]; do
          code=$(cert_code "$domain")
          [ "$code" = "200" ] && break
          sleep 3
        done

        if [ "$code" != "200" ]; then
          echo "" >&2
          echo "The certificate has not been issued after two minutes." >&2
          echo "  Caddy keeps trying, so this may still come good on its own." >&2
          echo "  Almost always one of: the A record does not point at this host yet," >&2
          echo "  or port 80 is closed inbound - Let's Encrypt has to reach it from" >&2
          echo "  outside, and a security group that allows only 443 fails here." >&2
          echo "" >&2
          echo "  Watch it: tama logs caddy" >&2
          echo "  Check again: tama expose status" >&2
          echo "" >&2
          echo "  .env is left in place so it can finish. 'tama expose --off' undoes it." >&2
          exit 1
        fi

        set_config_value publicBaseUrl "https://$domain" >/dev/null || true
        # Without this every per-caller limit keys on Caddy's container address,
        # so ten wrong tokens from anybody would lock out everybody.
        set_config_value trustProxy "true" >/dev/null || true
        written=$(config_value_server publicBaseUrl)
        if [ "$written" != "https://$domain" ]; then
          echo "! The config was not updated (got \"${written:-nothing}\")." >&2
          echo "  Serving works; clients told to use the address will be told the old one." >&2
        fi

        compose restart tama >/dev/null 2>&1 || true

        echo ""
        echo "Public at https://$domain"
        echo ""
        # Best effort and additive only: this is the one thing that separates
        # "the certificate is valid" from "the internet can actually reach 443",
        # and it legitimately returns 000 on a working cloud box that cannot
        # reach its own public address.
        outside=$(http_code "https://$domain/health" 8)
        case $outside in
          200) echo "  Reachable from outside this machine too." ;;
          000) echo "  Could not confirm from here, which is normal on a cloud instance:" ;
               echo "  a box usually cannot reach its own public address. Try it from a laptop." ;;
          *)   echo "  Answered $outside from the public address." ;;
        esac
        echo ""
        echo "Any client that can send a bearer token now reaches this from anywhere,"
        echo "not just from your own machines:"
        echo "  tama connect claude-code"
        echo ""
        echo "A hosted connector - ChatGPT, or Claude's custom connectors - can now"
        echo "REACH this, which it could not before. It still cannot connect: those"
        echo "want OAuth and this speaks bearer tokens. That is the remaining half."
        echo ""
        echo "Undo it with: tama expose --off"
        ;;

      tailscale)
        if ! command -v tailscale >/dev/null 2>&1; then
          echo "Tailscale puts this server on a private network of your own devices, with"
          echo "a stable HTTPS address. No domain, no certificates, nothing public."
          printf 'Install it? [y/N]: '
          read -r answer
          case $answer in [yY]*) ;; *) echo "Nothing changed."; exit 0 ;; esac
          curl -fsSL https://tailscale.com/install.sh | sh || { echo "install failed" >&2; exit 1; }
        fi

        # Logged in? `tailscale up` prints a URL to open in a browser, so it has
        # to be run interactively rather than swallowed.
        if ! tailscale status >/dev/null 2>&1; then
          echo "Signing this machine into your tailnet. Open the URL it prints:"
          sudo tailscale up || { echo "tailscale up failed" >&2; exit 1; }
        fi

        # The serve syntax has changed across releases, so try the forms in
        # order and report which one worked rather than guessing one and
        # failing opaquely.
        # Serve is a tailnet-wide feature and is OFF until somebody enables it
        # in the admin console, which is a second click after the device
        # sign-in. `tailscale serve` reacts by printing a URL and then WAITING
        # FOREVER for it to be visited - so this loop used to hang with no
        # output at all, because it sent both streams to /dev/null. An hour of
        # somebody's evening went into working that out.
        #
        # Captured rather than discarded, timed rather than trusted, and the
        # captured text is printed when nothing worked.
        served=""
        attempt_log=$(mktemp)
        for attempt in "--bg 8080" "--bg http://127.0.0.1:8080" "https / http://127.0.0.1:8080"; do
          # shellcheck disable=SC2086
          if timeout 20 sudo tailscale serve $attempt >>"$attempt_log" 2>&1; then
            served="tailscale serve $attempt"
            break
          fi
        done
        if [ -z "$served" ]; then
          # The one failure worth naming, because it is not an error the user
          # can fix on the box and the message is a URL to open.
          if grep -qi "not enabled on your tailnet" "$attempt_log"; then
            echo "Serve is not enabled on your tailnet yet. That is one click, in the admin console:" >&2
            grep -o "https://login.tailscale.com[^ ]*" "$attempt_log" | head -1 | sed "s/^/  /" >&2
            echo "" >&2
            echo "Open it, then run tama expose again. Signing the machine in was the first" >&2
            echo "click; this is the second, and it is per tailnet rather than per machine." >&2
          else
            echo "Could not configure tailscale serve. What it said:" >&2
            sed "s/^/  /" "$attempt_log" >&2
            echo "" >&2
            echo "Try it by hand to see more:" >&2
            echo "  sudo tailscale serve --bg 8080" >&2
          fi
          rm -f "$attempt_log"
          exit 1
        fi
        rm -f "$attempt_log"

        url=$(tailscale_url)
        if [ -z "$url" ]; then
          echo "Served ($served) but could not read this machine's tailnet name." >&2
          echo "  tailscale status --json | grep DNSName" >&2
          exit 1
        fi

        # Do not demote a public domain. server.publicBaseUrl is one key and
        # both paths write it, so a `tama expose` months after `--public` would
        # replace the domain with a tailnet name while Caddy keeps serving the
        # domain - and every client would then be handed the wrong address.
        if [ -n "$(public_domain)" ]; then
          echo "! server.publicBaseUrl still points at $(public_domain), and has been left there."
          echo "  This machine is now on the tailnet as well; both addresses work."
          echo "  'tama expose --off' gives the key back to the tailnet."
        else
          set_config_value publicBaseUrl "$url" || true
        fi

        echo ""
        echo "Reachable at $url"
        echo "  served with: $served"
        echo ""
        echo "MCP, from any of your machines, no tunnel:"
        echo "  tama token mcp-laptop            # on this server, prints once"
        echo "  claude mcp add --transport http tama $url/mcp \\"
        echo "    --header \"Authorization: Bearer PASTE_IT\""
        echo ""
        echo "Pair a phone, from anywhere on the tailnet:"
        echo "  $url/pair?token=\$(admin token from config/tama.config.json)"
        echo ""
        echo "This survives a reboot. Nothing needs to stay running in a terminal."
        ;;

      *) echo "usage: tama expose [tailscale|status|--off|--public DOMAIN]" >&2; exit 2 ;;
    esac
    ;;
  # The vault is a git repo; committing is how a note becomes recoverable.
  commit)   compose exec -T tama sh -c 'git -C /vault add -A && (git -C /vault diff --cached --quiet || git -C /vault commit -qm "tama commit") && git -C /vault log --oneline | head -1' ;;

  # Where the notes actually are, and moving them somewhere you can open.
  #
  # This lives in the wrapper rather than in `tama settings` because settings
  # runs inside a container: it cannot write the host's .env, cannot docker run
  # to copy a volume, cannot chown a host path, and has none of your SSH keys.
  # Handing the config wizard the Docker socket to make it possible would be a
  # far worse trade than one host command.
  vault)
    case ${1:-status} in
      move)
        shift
        target=${1:-$HOME/vault}
        current=$(vault_dir)
        if [ -n "$current" ]; then
          echo "The vault is already a folder: $current"
          echo "Nothing to move. To change where it lives, edit TAMA_VAULT_DIR in .env."
          exit 0
        fi
        volume=$(docker volume ls --format '{{.Name}}' | grep -E '_tama-vault$' | head -1)
        if [ -z "$volume" ]; then echo "No tama vault volume found. Is this the right directory?" >&2; exit 1; fi

        before=$(compose exec -T tama sh -c 'find /vault -name "*.md" | wc -l' 2>/dev/null | tr -d ' \r')
        echo "Moving the vault out of Docker and into a folder you can open."
        echo "  from:  volume $volume"
        echo "  to:    $target"
        echo "  notes: ${before:-unknown}"
        echo ""
        echo "The volume is left untouched, so this is reversible until you delete it."
        printf 'Go ahead? [y/N]: '
        read -r answer
        case $answer in [yY]*) ;; *) echo "Nothing changed."; exit 0 ;; esac

        mkdir -p "$target"
        # Copied inside a container so the source needs no host permissions,
        # and -a to keep the git directory and the file times intact.
        docker run --rm -v "$volume":/from:ro -v "$target":/to alpine sh -c 'cp -a /from/. /to/'
        sudo chown -R "$(id -u):$(id -g)" "$target"

        # Replaced rather than appended: a second TAMA_VAULT_DIR line would win
        # silently and leave the first one looking authoritative.
        touch .env
        sed -i '/^TAMA_VAULT_DIR=/d' .env
        echo "TAMA_VAULT_DIR=$target" >> .env

        compose up -d --build >/dev/null
        after=$(find "$target" -name '*.md' -not -path '*/.*' | wc -l | tr -d ' ')
        echo ""
        echo "Moved. $after notes in $target"
        if [ -n "$before" ] && [ "$before" != "$after" ]; then
          echo "WARNING: the server counted $before before the move. Check before deleting the volume." >&2
        fi
        echo ""
        echo "  ls $target"
        echo "  tama vault                     where it is and what git thinks"
        echo "  tama remote <git url>          if you want it pushed somewhere"
        echo ""
        echo "When you are satisfied:  docker volume rm $volume"
        exit 0
        ;;
      status) ;;
      *) echo "usage: tama vault [status|move [path]]" >&2; exit 2 ;;
    esac
    dir=$(vault_dir)
    if [ -n "$dir" ]; then
      echo "vault:   $dir"
      echo "notes:   $(find "$dir" -name '*.md' -not -path '*/.*' 2>/dev/null | wc -l | tr -d ' ')"
      echo "git:     $(git -C "$dir" log --oneline -1 2>/dev/null || echo 'no commits yet')"
      uncommitted=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
      [ "$uncommitted" = "0" ] || echo "pending: $uncommitted uncommitted change(s)"
      remote=$(git -C "$dir" remote get-url --push origin 2>/dev/null || true)
      echo "remote:  ${remote:-none. set one with: tama remote <url>}"
    else
      echo "vault:   inside the Docker volume tama_tama-vault"
      echo "         /var/lib/docker/volumes/tama_tama-vault/_data (root-owned)"
      echo "notes:   $(compose exec -T tama sh -c 'find /vault -name "*.md" | wc -l' 2>/dev/null | tr -d ' \r')"
      echo ""
      echo "To make it a folder you can open, and push to a remote:"
      echo "  see docs/deploy-docker.md section 13b"
    fi
    ;;

  # Pushing happens on the host, not in the container: the host has the SSH
  # keys and the agent, and putting a deploy key inside an image to push
  # somebody's private notes is the wrong shape.
  remote)
    dir=$(require_vault_dir) || exit 1
    if [ $# -eq 0 ]; then git -C "$dir" remote -v; exit 0; fi
    if git -C "$dir" remote get-url origin >/dev/null 2>&1; then
      git -C "$dir" remote set-url origin "$1"
    else
      git -C "$dir" remote add origin "$1"
    fi
    echo "remote set. first push:  tama sync"
    ;;

  sync)
    dir=$(require_vault_dir) || exit 1
    git -C "$dir" add -A
    git -C "$dir" diff --cached --quiet || git -C "$dir" commit -qm "tama: sync $(date -Iseconds)"
    if ! git -C "$dir" remote get-url --push origin >/dev/null 2>&1; then
      echo "committed. no remote yet, so nothing was pushed." >&2
      echo "  set one:  tama remote git@github.com:you/vault-private.git" >&2
      exit 0
    fi
    branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD)
    git -C "$dir" push -u origin "$branch"
    ;;
  notes)    compose exec -T tama sh -c 'find /vault -name "*.md" | wc -l' ;;
  # A client needs a token; two curl calls against /pair was the alternative.
  token)
    if [ $# -eq 0 ]; then echo 'usage: tama token NAME [--as AUDIENCE]' >&2; exit 2; fi
    compose exec -T tama bun run src/tama.ts token "$@" ;;

  # Reads the summary on stdin, so an agent can pipe one straight in.
  session)
    if [ $# -eq 0 ]; then echo 'usage: tama session PROJECT [--shipped X] [--next Y] < summary.md' >&2; exit 2; fi
    compose exec -T tama bun run src/tama.ts session "$@" ;;
  # --force-recreate caddy when public: docker/Caddyfile arrives as a read-only
  # bind mount, so its CONTENTS are not part of the service's config hash and
  # `up -d` leaves the old container running with the old config. A fix to the
  # Caddyfile would otherwise land on disk and do nothing.
  update)
    git pull && compose up -d --build
    if [ -n "$(public_domain)" ]; then
      compose up -d --force-recreate caddy >/dev/null 2>&1 || true
    fi
    ;;
  ask)
    if [ $# -eq 0 ]; then echo "usage: tama ask \"your question\"" >&2; exit 2; fi
    # Read the token inside the container. The wizard writes the config 0600 and
    # root-owned, so reading it from the host needs sudo for no good reason: the
    # server already has it mounted.
    admin=$(compose exec -T tama sh -c 'sed -n "s/.*\"adminToken\": *\"\([^\"]*\)\".*/\1/p" "$TAMA_CONFIG" | head -1' 2>/dev/null | tr -d '\r')
    if [ -z "$admin" ]; then echo "could not read the admin token; is tama running? (tama status)" >&2; exit 1; fi
    curl -s -X POST localhost:8080/ask \
      -H "Authorization: Bearer $admin" -H 'content-type: application/json' \
      --data-raw "$(printf '{"question":%s}' "$(printf '%s' "$*" | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/')")"
    echo
    ;;
  help|--help|-h)
    cat <<'USAGE'
tama setup                  first-run wizard: vault, transcription, Ask, WhatsApp
tama settings               audiences and views, your own numbers, devices
tama start                  build and start everything configured
tama restart                apply a config or settings change
tama stop                   stop the containers, volumes survive
tama status                 what is running
tama logs [service]         follow logs; defaults to tama
tama health                 the /health JSON
tama mcp [NAME]             the whole editor-plugin install, as a line to paste
tama expose                 put this server on your tailnet, no tunnel, no domain
tama expose --public DOMAIN  put it on the public internet, with TLS
tama expose status          how this server is currently reachable
tama expose --off           stop serving, either way
tama expose status          how it is currently reachable
tama ask "question"         ask your notes from the terminal
tama token NAME             mint a device token for a client (iOS, MCP, a script)
tama session PROJECT        record what a session did; summary on stdin
tama notes                  how many Markdown notes are in the vault
tama vault                  where the notes are, and their git state
tama vault move [path]      move it out of Docker into a folder (default ~/vault)
tama remote [url]           set or show the vault's git remote
tama sync                   commit the vault and push it
tama commit                 commit the vault's git repo
tama update                 git pull, then rebuild and restart
USAGE
    ;;
  *) echo "tama: unknown command '$command'. Try: tama help" >&2; exit 2 ;;
esac
