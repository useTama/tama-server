#!/bin/sh
# `tama <command>` for a Docker deployment.
#
# The installed binary is `tama-server`; a container deployment has no binary on
# the host, and asking someone to remember
#
#   docker compose --profile whatsapp-webjs logs -f whatsapp-webjs
#
# to read a log is deployment plumbing leaking into the interface. This wrapper
# is the host-side equivalent of the CLI, run from wherever the repo is:
#
#   sudo ln -s "$PWD/docker/tama" /usr/local/bin/tama
#
# It resolves its own location, so the symlink works from any directory.
set -e

# Compose warns on every invocation that it wants to build with Bake but buildx
# is missing. It is advice about a build backend, printed before a command that
# may not build anything.
export COMPOSE_BAKE=${COMPOSE_BAKE:-false}

self=$0
# Follow the symlink so TAMA_DIR is the repo, not /usr/local/bin.
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *)  self=$(dirname "$self")/$link ;;
  esac
done
TAMA_DIR=${TAMA_DIR:-$(cd "$(dirname "$self")/.." && pwd)}
cd "$TAMA_DIR"

# Every command that touches the bridge needs its profile, or Compose treats the
# container as an orphan and stops it. Getting that wrong is the single most
# common way to break a working install, so the wrapper always passes it.
compose() { docker compose --profile whatsapp-webjs "$@"; }

# Where the vault is on this host, or empty when it is still a Docker volume.
# Read from .env rather than the config, because the config's path is a
# container path and this runs outside.
vault_dir() {
  [ -f .env ] || return 0
  dir=$(sed -n 's/^TAMA_VAULT_DIR=//p' .env | tail -1)
  [ -n "$dir" ] && [ -d "$dir" ] && printf '%s' "$dir"
}

require_vault_dir() {
  dir=$(vault_dir)
  if [ -z "$dir" ]; then
    echo "The vault is still inside a Docker volume, so git on this host cannot reach it." >&2
    echo "Move it to a folder first: docs/deploy-docker.md section 13b" >&2
    return 1
  fi
  printf '%s' "$dir"
}

# The wizards still build, so that a `git pull` takes effect rather than running
# whatever the image happened to contain - a stale settings image is how you end
# up answering questions the running code does not read. Cached, that is about a
# second, and there is no reason to print thirty lines of layer cache hits for
# it.
wizard() { docker compose --progress quiet run --rm --build "$@"; }

command=${1:-help}
[ $# -gt 0 ] && shift

case $command in
  setup)    wizard setup "$@" ;;
  settings) wizard settings "$@" ;;
  start|up) compose up -d --build "$@" ;;
  stop)     compose stop "$@" ;;
  restart)  compose up -d --build "$@" ;;
  status|ps) compose ps "$@" ;;
  logs)     compose logs -f --tail 100 "${@:-tama}" ;;
  health)   curl -s localhost:8080/health ;;
  # The vault is a git repo; committing is how a note becomes recoverable.
  commit)   compose exec -T tama sh -c 'git -C /vault add -A && (git -C /vault diff --cached --quiet || git -C /vault commit -qm "tama commit") && git -C /vault log --oneline | head -1' ;;

  # Where the notes actually are, and moving them somewhere you can open.
  #
  # This lives in the wrapper rather than in `tama settings` because settings
  # runs inside a container: it cannot write the host's .env, cannot docker run
  # to copy a volume, cannot chown a host path, and has none of your SSH keys.
  # Handing the config wizard the Docker socket to make it possible would be a
  # far worse trade than one host command.
  vault)
    case ${1:-status} in
      move)
        shift
        target=${1:-$HOME/vault}
        current=$(vault_dir)
        if [ -n "$current" ]; then
          echo "The vault is already a folder: $current"
          echo "Nothing to move. To change where it lives, edit TAMA_VAULT_DIR in .env."
          exit 0
        fi
        volume=$(docker volume ls --format '{{.Name}}' | grep -E '_tama-vault$' | head -1)
        if [ -z "$volume" ]; then echo "No tama vault volume found. Is this the right directory?" >&2; exit 1; fi

        before=$(compose exec -T tama sh -c 'find /vault -name "*.md" | wc -l' 2>/dev/null | tr -d ' \r')
        echo "Moving the vault out of Docker and into a folder you can open."
        echo "  from:  volume $volume"
        echo "  to:    $target"
        echo "  notes: ${before:-unknown}"
        echo ""
        echo "The volume is left untouched, so this is reversible until you delete it."
        printf 'Go ahead? [y/N]: '
        read -r answer
        case $answer in [yY]*) ;; *) echo "Nothing changed."; exit 0 ;; esac

        mkdir -p "$target"
        # Copied inside a container so the source needs no host permissions,
        # and -a to keep the git directory and the file times intact.
        docker run --rm -v "$volume":/from:ro -v "$target":/to alpine sh -c 'cp -a /from/. /to/'
        sudo chown -R "$(id -u):$(id -g)" "$target"

        # Replaced rather than appended: a second TAMA_VAULT_DIR line would win
        # silently and leave the first one looking authoritative.
        touch .env
        sed -i '/^TAMA_VAULT_DIR=/d' .env
        echo "TAMA_VAULT_DIR=$target" >> .env

        compose up -d --build >/dev/null
        after=$(find "$target" -name '*.md' -not -path '*/.*' | wc -l | tr -d ' ')
        echo ""
        echo "Moved. $after notes in $target"
        if [ -n "$before" ] && [ "$before" != "$after" ]; then
          echo "WARNING: the server counted $before before the move. Check before deleting the volume." >&2
        fi
        echo ""
        echo "  ls $target"
        echo "  tama vault                     where it is and what git thinks"
        echo "  tama remote <git url>          if you want it pushed somewhere"
        echo ""
        echo "When you are satisfied:  docker volume rm $volume"
        exit 0
        ;;
      status) ;;
      *) echo "usage: tama vault [status|move [path]]" >&2; exit 2 ;;
    esac
    dir=$(vault_dir)
    if [ -n "$dir" ]; then
      echo "vault:   $dir"
      echo "notes:   $(find "$dir" -name '*.md' -not -path '*/.*' 2>/dev/null | wc -l | tr -d ' ')"
      echo "git:     $(git -C "$dir" log --oneline -1 2>/dev/null || echo 'no commits yet')"
      uncommitted=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
      [ "$uncommitted" = "0" ] || echo "pending: $uncommitted uncommitted change(s)"
      remote=$(git -C "$dir" remote get-url --push origin 2>/dev/null || true)
      echo "remote:  ${remote:-none. set one with: tama remote <url>}"
    else
      echo "vault:   inside the Docker volume tama_tama-vault"
      echo "         /var/lib/docker/volumes/tama_tama-vault/_data (root-owned)"
      echo "notes:   $(compose exec -T tama sh -c 'find /vault -name "*.md" | wc -l' 2>/dev/null | tr -d ' \r')"
      echo ""
      echo "To make it a folder you can open, and push to a remote:"
      echo "  see docs/deploy-docker.md section 13b"
    fi
    ;;

  # Pushing happens on the host, not in the container: the host has the SSH
  # keys and the agent, and putting a deploy key inside an image to push
  # somebody's private notes is the wrong shape.
  remote)
    dir=$(require_vault_dir) || exit 1
    if [ $# -eq 0 ]; then git -C "$dir" remote -v; exit 0; fi
    if git -C "$dir" remote get-url origin >/dev/null 2>&1; then
      git -C "$dir" remote set-url origin "$1"
    else
      git -C "$dir" remote add origin "$1"
    fi
    echo "remote set. first push:  tama sync"
    ;;

  sync)
    dir=$(require_vault_dir) || exit 1
    git -C "$dir" add -A
    git -C "$dir" diff --cached --quiet || git -C "$dir" commit -qm "tama: sync $(date -Iseconds)"
    if ! git -C "$dir" remote get-url --push origin >/dev/null 2>&1; then
      echo "committed. no remote yet, so nothing was pushed." >&2
      echo "  set one:  tama remote git@github.com:you/vault-private.git" >&2
      exit 0
    fi
    branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD)
    git -C "$dir" push -u origin "$branch"
    ;;
  notes)    compose exec -T tama sh -c 'find /vault -name "*.md" | wc -l' ;;
  # A client needs a token; two curl calls against /pair was the alternative.
  token)
    if [ $# -eq 0 ]; then echo 'usage: tama token NAME [--as AUDIENCE]' >&2; exit 2; fi
    compose exec -T tama bun run src/tama.ts token "$@" ;;

  # Reads the summary on stdin, so an agent can pipe one straight in.
  session)
    if [ $# -eq 0 ]; then echo 'usage: tama session PROJECT [--shipped X] [--next Y] < summary.md' >&2; exit 2; fi
    compose exec -T tama bun run src/tama.ts session "$@" ;;
  update)   git pull && compose up -d --build ;;
  ask)
    if [ $# -eq 0 ]; then echo "usage: tama ask \"your question\"" >&2; exit 2; fi
    # Read the token inside the container. The wizard writes the config 0600 and
    # root-owned, so reading it from the host needs sudo for no good reason: the
    # server already has it mounted.
    admin=$(compose exec -T tama sh -c 'sed -n "s/.*\"adminToken\": *\"\([^\"]*\)\".*/\1/p" "$TAMA_CONFIG" | head -1' 2>/dev/null | tr -d '\r')
    if [ -z "$admin" ]; then echo "could not read the admin token; is tama running? (tama status)" >&2; exit 1; fi
    curl -s -X POST localhost:8080/ask \
      -H "Authorization: Bearer $admin" -H 'content-type: application/json' \
      --data-raw "$(printf '{"question":%s}' "$(printf '%s' "$*" | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/')")"
    echo
    ;;
  help|--help|-h)
    cat <<'USAGE'
tama setup                  first-run wizard: vault, transcription, Ask, WhatsApp
tama settings               audiences and views, your own numbers, devices
tama start                  build and start everything configured
tama restart                apply a config or settings change
tama stop                   stop the containers, volumes survive
tama status                 what is running
tama logs [service]         follow logs; defaults to tama
tama health                 the /health JSON
tama ask "question"         ask your notes from the terminal
tama token NAME             mint a device token for a client (iOS, MCP, a script)
tama session PROJECT        record what a session did; summary on stdin
tama notes                  how many Markdown notes are in the vault
tama vault                  where the notes are, and their git state
tama vault move [path]      move it out of Docker into a folder (default ~/vault)
tama remote [url]           set or show the vault's git remote
tama sync                   commit the vault and push it
tama commit                 commit the vault's git repo
tama update                 git pull, then rebuild and restart
USAGE
    ;;
  *) echo "tama: unknown command '$command'. Try: tama help" >&2; exit 2 ;;
esac
