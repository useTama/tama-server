{
  "name": "tama-server",
  "version": "0.1.0",
  "description": "Self-hosted voice capture into a markdown vault you own. No account, no key, no bill.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/tama.ts",
    "start": "bun run src/tama.ts",
    "setup": "bun run src/tama.ts setup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/tama.ts --compile --outfile dist/tama-server",
    "eval": "bun test test/eval",
    "pack:desktop": "cd clients/claude-desktop && bunx @anthropic-ai/mcpb pack . ../../dist/tama.mcpb"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0"
  }
}
