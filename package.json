{
  "name": "tama-server",
  "version": "0.1.0",
  "description": "Your digital twin, with a memory you own. Self-hosted voice capture and question answering over a markdown vault. No account, no key, no bill.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/tama.ts",
    "start": "bun run src/tama.ts",
    "setup": "bun run src/tama.ts setup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/tama.ts --compile --outfile dist/tama-server"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0"
  }
}
